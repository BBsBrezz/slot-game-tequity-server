{
    "name": "slot-game-tequity-server",
    "version": "1.0.0",
    "author": "NFHarryLu",
    "description": "Slot Game Server for Tequity Platform",
    "license": "UNLICENSED",
    "main": "lib/games/slot-game/index.js",
    "scripts": {
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "test": "jest --runInBand",
        "build": "rm -Rf lib/* && tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "start": "node mock-api-server.js",
        "obfuscate": "npx --yes javascript-obfuscator --target=node --options-preset=low-obfuscation --output lib/ lib/ && rm -Rf lib/**/*.d.ts && rm -Rf ./**/*.ts"
    },
    "dependencies": {
        "body-parser": "^2.2.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "http-terminator": "^3.2.0",
        "typescript": "^4.7.4"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.1.0",
        "@typescript-eslint/parser": "^7.1.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "ts-node-dev": "^2.0.0"
    }
}
